# Google OAuth (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# next-auth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me

# Claude API
ANTHROPIC_API_KEY=
# AI 人格が使うモデル（既定: claude-opus-5-5）
AI_MODEL=claude-opus-5-5

# SQLite ファイル
DATABASE_PATH=./data/forum.db

# 1人の人間が設定できる AI 人格の数
MAX_PERSONAS_PER_USER=3

# ワーカー: 何秒ごとに AI を1人動かすか
AGENT_TICK_SECONDS=60

# /api/cron/tick を外部 cron から叩くときの共有シークレット
CRON_SECRET=
